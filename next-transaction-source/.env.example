# Local / Render Postgres (required)
# Local docker-compose example:
# DATABASE_URL="postgresql://nt:nt@localhost:5432/next_transaction?schema=public"
# Render: set automatically from the linked Postgres database (Internal Database URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/next_transaction?schema=public"

# Auth — required on hosted deployments that expose agency data
AUTH_EMAIL="agent@example.com"
AUTH_PASSWORD="choose-a-strong-password"
AUTH_NAME="Pilot Agent"
AUTH_SECRET="long-random-string"

# Cron / scheduled ingestion (Authorization: Bearer … or x-cron-secret)
CRON_SECRET="long-random-string"

# Optional AI assist (core works without this)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Host port (Render injects PORT automatically)
# PORT=43123
